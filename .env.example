# Copy to .env for local development. Never commit the resulting file.
APP_ENV=local
# Relative SQLite paths resolve from prisma/schema.prisma.
DATABASE_URL="file:./dev.db"
NEXTAUTH_URL="http://localhost:3000"
# Generate a unique value with: openssl rand -base64 48
NEXTAUTH_SECRET=""
# Create a Google OAuth web client; use callback:
# http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Exact normalized domains only; an eligible email still requires membership review.
ACADEMIC_EMAIL_DOMAINS="iiml.ac.in"
# Creates no fixtures by default; use npm run db:fixtures for an owned temporary DB.
# Direct seed commands additionally require an explicit opt-in, APP_ENV local/test,
# NODE_ENV development/test, and FIXTURE_DATABASE_DIR matching that temporary DB.
ALLOW_DEMO_SEED=0
ALLOW_DEV_SEED=0
# Runtime URL fetching/sync are disabled in code throughout P2; this flag is kept
# at zero for compatibility and does not re-enable ingestion when set to one.
ENABLE_AUTO_CONFERENCE_SYNC=0
