// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id                      String   @id @default(cuid())
  name                    String?
  email                   String?  @unique
  emailVerified           DateTime?
  image                   String?
  
  // Custom fields for Shadow Directory
  current_institution     String?
  current_title           String?
  research_domain         String?
  methodological_expertise String? // Comma-separated tags
  open_to_chat            Boolean  @default(false)
  
  // NextAuth required fields
  accounts                Account[]
  sessions                Session[]
  
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  // Relationships
  conferencesAttending    ConferenceAttendee[]
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Phase 1: Conference Tracker
model Conference {
  id          String   @id @default(cuid())
  name        String
  date        DateTime
  location    String
  description String?
  url         String?
  
  attendees   ConferenceAttendee[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ConferenceAttendee {
  id           String   @id @default(cuid())
  userId       String
  conferenceId String
  status       String   @default("attending") // e.g. attending, considering
  
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  conference   Conference @relation(fields: [conferenceId], references: [id], onDelete: Cascade)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  @@unique([userId, conferenceId])
}
