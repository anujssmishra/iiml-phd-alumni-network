{
  "name": "iiml-phd-alumni-network",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25",
    "npm": ">=10"
  },
  "packageManager": "npm@10.7.0",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "node scripts/isolated-database.mjs build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:migrate": "node scripts/migrate.mjs",
    "db:seed": "tsx prisma/seed.ts",
    "admin:bootstrap": "tsx scripts/bootstrap-admin.ts",
    "test": "node scripts/isolated-database.mjs test",
    "test:e2e": "node scripts/isolated-database.mjs browser",
    "check": "npm run db:generate && npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "@prisma/client": "6.19.3",
    "next-auth": "^4.24.11",
    "@next-auth/prisma-adapter": "^1.0.7",
    "lucide-react": "^0.470.0"
  },
  "devDependencies": {
    "prisma": "6.19.3",
    "@tailwindcss/postcss": "^4.1.0",
    "@playwright/test": "^1.56.0",
    "tsx": "^4.20.0",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
